# --- Dashboard auth (required in production) ---
# Any number of team accounts, comma-separated: email:password
JUBILEE_TEAM_ACCOUNTS="admin@jubileesales.in:change-me-now"
# 32+ char random string used to sign session cookies
JUBILEE_SESSION_SECRET="replace-with-openssl-rand-base64-32"

# --- Data layer ---
# Unset  -> local JSON store at .data/ (dev only, works out of the box)
# Set    -> Postgres (Supabase / Neon / any PG). Run `npm run db:init` once.
# DATABASE_URL="postgresql://user:pass@host:5432/db?sslmode=require"

# --- Media storage ---
# Unset  -> uploads written to public/uploads (dev only)
# Set    -> Cloudinary unsigned upload preset
# CLOUDINARY_CLOUD_NAME=""
# CLOUDINARY_UPLOAD_PRESET=""
